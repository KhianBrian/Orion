# Edge Function environment for the synthetic/staging Direct WebRTC boundary.
# Copy to supabase/.env.local or a deployment secret store; never commit real values.
DIRECT_WEBRTC_SIGNALING_URL=wss://signaling-staging.example.invalid/signaling
DIRECT_WEBRTC_TURN_URLS=turn:turn-staging.example.invalid:3478,turns:turn-staging.example.invalid:5349
DIRECT_WEBRTC_TURN_SECRET=
DIRECT_WEBRTC_SIGNALING_SECRET=

# Local only:
# supabase functions serve video-session-access --no-verify-jwt --env-file supabase/.env.local
