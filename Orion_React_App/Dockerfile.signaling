FROM node:22-alpine

WORKDIR /app

ENV NODE_ENV=production \
    DIRECT_WEBRTC_SIGNALING_HOST=0.0.0.0 \
    DIRECT_WEBRTC_SIGNALING_PORT=8787

COPY tools/direct-webrtc-signaling.mjs ./tools/direct-webrtc-signaling.mjs

USER node
EXPOSE 8787

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8787/healthz').then((response) => { if (!response.ok) process.exit(1); }).catch(() => process.exit(1))"

CMD ["node", "tools/direct-webrtc-signaling.mjs"]
