{
  "name": "orion-react-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-bundle-budget.mjs",
    "lint": "eslint .",
    "prelint": "npm run phase-status:sync && npm run phase-status:check",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:db:phase185": "node scripts/test-phase185-db.mjs",
    "test:load:phase185": "node tools/direct-webrtc-load.mjs",
    "check:env-examples": "node scripts/check-env-examples.mjs",
    "phase-status:sync": "node scripts/sync-phase-status.mjs --fix",
    "phase-status:check": "node scripts/sync-phase-status.mjs --check",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:authenticated": "RUN_SCHEDULING_E2E=1 playwright test tests/e2e/scheduling.spec.js",
    "test:db:booking": "node scripts/test-booking-db.mjs",
    "test:db:cancellation": "node scripts/test-cancellation-db.mjs",
    "test:db:rls": "node scripts/test-rls-db.mjs",
    "test:db:phase2": "node scripts/test-phase2-db.mjs",
    "test:db:phase4": "node scripts/test-phase4-db.mjs",
    "test:db:phase14": "node scripts/test-phase14-db.mjs",
    "test:db:phase15": "node scripts/test-phase15-db.mjs",
    "test:auth:no-email": "node --env-file=.env scripts/test-phase3-auth-no-email.mjs",
    "seed:human-checks": "node --env-file=.env scripts/seed-human-checks.mjs",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report test-artifacts/playwright/report",
    "signaling:synthetic": "node tools/direct-webrtc-signaling.mjs"
  },
  "dependencies": {
    "@casl/ability": "6.8.1",
    "@jitsi/react-sdk": "1.4.4",
    "@supabase/supabase-js": "2.112.4",
    "@tanstack/react-query": "^5.102.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "7.18.3",
    "react-toastify": "^11.0.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "vite": "^7.2.4"
  }
}
