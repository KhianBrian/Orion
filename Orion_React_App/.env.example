# Public, browser-safe configuration only. Do not add secrets here.
VITE_API_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
# Synthetic demo only; set true only in a local synthetic test environment.
VITE_DEMO_AUTH_PERSISTENCE=
# UI exposure for the synthetic Direct WebRTC route; server admission remains authoritative.
# This is the only Direct WebRTC value that belongs in browser configuration.
VITE_DIRECT_WEBRTC_UI=
# Optional synthetic-demo convenience setting. Leave empty for separate account passwords.
DEMO_SHARED_PASSWORD=
